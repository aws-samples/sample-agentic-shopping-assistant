# Copy to packages/web/.env and fill in from the deployed stack outputs (see docs/guides/getting-started.md).
# API_URL: http://<ALBDns>:<serverPort> on Dev without a certificate, or your HTTPS API host.
API_URL=""
AUTH_PROVIDER="cognito"
# Use the exact managed Cognito or BYO OIDC issuer and public client ID.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# aria-tools/invoke lets the agent exchange this token for its Gateway token.
OIDC_SCOPES="openid profile email aria/chat aria-tools/invoke"
OIDC_REDIRECT_URI="http://localhost:4000/auth/callback"
OIDC_LOGOUT_URI="http://localhost:4000/"
BRAND_NAME="NORDLY"
# Seconds the browser waits for a whole chat turn. Keep it above the API's requestTimeout (default 120).
NUXT_PUBLIC_REQUEST_TIMEOUT_SECONDS="130"
# Extra image origins for the Content-Security-Policy, space-separated http(s) origins such as
# https://images.example.com. Empty allows images from this app and data: URLs only. Build time.
NUXT_PUBLIC_CSP_IMG_SRC=""
